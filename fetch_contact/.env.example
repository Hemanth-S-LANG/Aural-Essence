# ── API Keys ────────────────────────────────────────────────────────────────
# Gemini (Google AI Studio): https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Grok (xAI): https://console.x.ai/
XAI_API_KEY=your_grok_api_key_here

# ── Settings ─────────────────────────────────────────────────────────────────
REQUEST_DELAY=3.5          # seconds between requests
MAX_SEARCH_RESULTS=5       # how many Google results to check per seller
CHECKPOINT_EVERY=25        # save progress every N sellers
MISSING_ONLY=true          # only process rows where Phone Status = HIDDEN/MISSING
