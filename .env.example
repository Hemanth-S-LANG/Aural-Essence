# ── Product ─────────────────────────────────────────────────────
# Comma-separated list of search keywords (do NOT hardcode in scraper logic)
SEARCH_PRODUCTS=Rose Water

# ── Crawl limits ─────────────────────────────────────────────────
MAX_PAGES=3                  # pages to paginate per source
REQUEST_DELAY=3              # seconds between requests
REQUEST_TIMEOUT=15           # HTTP timeout per request
MAX_RETRIES=3                # tenacity retry attempts

# ── Output ───────────────────────────────────────────────────────
OUTPUT_FILE=output/rose_water_customers.xlsx
OVERWRITE_OUTPUT=true        # false = timestamp the filename

# ── Storage ──────────────────────────────────────────────────────
DB_PATH=data/leads.db
RAW_HTML_DIR=data/raw_html

# ── Rendering ────────────────────────────────────────────────────
USE_PLAYWRIGHT=false         # true = use Playwright for JS-heavy pages

# ── Logging ──────────────────────────────────────────────────────
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR
LOG_DIR=logs
